---
import Container from '@/components/Container.astro';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const links = [
  { href: '/om-oss/', label: 'Om oss' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---

<header class="border-b border-border">
  <Container class="flex h-16 items-center justify-between">
    <a href="/" class="text-base font-semibold text-foreground">OTG Solutions</a>
    <nav class="flex items-center gap-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={path === link.href ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors hover:text-foreground',
              path === link.href ? 'text-foreground' : 'text-muted-foreground',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </Container>
</header>
