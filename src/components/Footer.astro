---
import Container from '@/components/Container.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <Container class="flex flex-wrap items-start justify-between gap-6 py-10">
    <div class="space-y-1">
      <p class="text-sm font-medium">OTG Solutions AS</p>
      <p class="text-sm text-muted-foreground">Oslo · Fredrikstad</p>
      <p class="text-xs text-muted-foreground">© {year}</p>
    </div>
    <div class="space-y-1 font-mono text-xs text-muted-foreground md:text-right">
      <p class="tabular-nums">Org.nr. 924 974 168</p>
      <p>
        <a href="mailto:post@otg-solutions.no" class="transition-colors hover:text-foreground">post@otg-solutions.no</a>
      </p>
      <p>
        <a
          href="https://www.linkedin.com/company/otg-solutions-as/"
          target="_blank"
          rel="noopener"
          class="transition-colors hover:text-foreground"
        >
          LinkedIn ↗
        </a>
      </p>
    </div>
  </Container>
</footer>
